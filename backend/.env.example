# Default/online database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=online_quiz_dev
DB_USERNAME=postgres
DB_PASSWORD=

# Spring profile: online or local-exam
SPRING_PROFILES_ACTIVE=online

# Local exam example:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=online_quiz_exam
# DB_USERNAME=postgres
# DB_PASSWORD=your-local-password
# SPRING_PROFILES_ACTIVE=local-exam
# SERVER_ADDRESS=0.0.0.0
# PORT=8080
# EXAM_TIME_ZONE=Asia/Kolkata

JWT_SECRET=change-this-secret
JWT_EXPIRATION_MS=3600000

# Online-only OAuth variables
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_VERIFICATION_REQUIRED=false
