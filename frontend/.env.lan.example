# LAN exam environment.
# Copy this file to frontend/.env.local and replace BOTH IP placeholders with the
# actual LAN address of the machine running Spring Boot and the LAN address
# used by the Next.js development server.

NEXT_PUBLIC_EXAM_MODE=LAN
NEXT_PUBLIC_API_URL=http://YOUR_BACKEND_LAN_IP:8080
ALLOWED_DEV_ORIGINS=YOUR_FRONTEND_LAN_IP:3000
